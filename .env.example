# Variables del editor del sitio. En producción se configuran en Vercel
# (Project → Settings → Environment Variables); para probar en local,
# copia este archivo a .env.local (no se sube a GitHub).

# Contraseña del editor (Víctor). Cambiarla cierra todas las sesiones abiertas.
ADMIN_PASSWORD=

# Token de GitHub con permiso «Contents: Read and write» solo sobre este repositorio
# (fine-grained personal access token). No hace falta para dev/server.py.
GITHUB_TOKEN=

# Repositorio y rama de producción donde se guardan los cambios.
GITHUB_REPO=andreasssbh/organization-deportiva-
GITHUB_BRANCH=claude/practical-lamport-54u3mt
